<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.master.cs" Inherits="Temp5.Site1" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GreenLeaf Nursery</title>

    <!-- Google Fonts: Fraunces for headings, Karla for body text -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600;700&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="CSS/style.css">
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            <!-- ================= NAVBAR ================= -->
            <nav class="navbar navbar-expand-lg sticky-top">
                <div class="container">
                    <a class="navbar-brand" href="index.aspx">
                        <span class="brand-icon"><i class="fa-solid fa-seedling"></i></span>
                        GreenLeaf Nursery
                    </a>

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="mainNavbar">
                        <ul class="navbar-nav ms-auto align-items-lg-center">
                            <li class="nav-item">
                                <a class="nav-link <%= GetActiveClass("index.aspx") %>" href="index.aspx">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link <%= GetActiveClass("AboutUs.aspx") %>" href="AboutUs.aspx">About Us</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link <%= GetActiveClass("Plants.aspx") %>" href="Plants.aspx">Plants</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link <%= GetActiveClass("Services.aspx") %>" href="Services.aspx">Services</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link <%= GetActiveClass("ContactUs.aspx") %>" href="ContactUs.aspx">Contact Us</a>
                            </li>
                            <%--<li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                                <a href="ContactUs.aspx" class="btn btn-success px-4">Get in Touch</a>
                            </li>--%>
                        </ul>
                    </div>
                </div>
            </nav>
        </asp:ContentPlaceHolder>

        <asp:ContentPlaceHolder ID="ContentPlaceHolder2" runat="server"></asp:ContentPlaceHolder>

        <asp:ContentPlaceHolder ID="ContentPlaceHolder3" runat="server">
            <!-- ================= FOOTER ================= -->
            <footer class="site-footer">
                <div class="container">
                    <div class="row g-4">
                        <div class="col-lg-5 col-md-6">
                            <h4 class="footer-logo"><i class="fa-solid fa-seedling"></i>GreenLeaf Nursery</h4>
                            <p class="footer-text">
                                We bring nature closer to your home with fresh, healthy and
                                beautiful plants for every space.
                            </p>
                            <div class="social-links">
                                <a href="#" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                                <a href="#" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                                <a href="#" aria-label="Twitter"><i class="fa-brands fa-x-twitter"></i></a>
                                <a href="#" aria-label="YouTube"><i class="fa-brands fa-youtube"></i></a>
                            </div>
                        </div>

                        <div class="col-lg-3 col-md-6">
                            <h5 class="footer-title">Quick Links</h5>
                            <ul class="footer-links">
                                <li><a href="index.aspx"><i class="fa-solid fa-angle-right"></i>Home</a></li>
                                <li><a href="AboutUs.aspx"><i class="fa-solid fa-angle-right"></i>About Us</a></li>
                                <li><a href="Plants.aspx"><i class="fa-solid fa-angle-right"></i>Our Plants</a></li>
                                <li><a href="Services.aspx"><i class="fa-solid fa-angle-right"></i>Services</a></li>
                                <li><a href="ContactUs.aspx"><i class="fa-solid fa-angle-right"></i>Contact Us</a></li>
                            </ul>
                        </div>

                        <div class="col-lg-4 col-md-6">
                            <h5 class="footer-title">Contact Us</h5>
                            <p class="footer-contact">
                                <i class="fa-solid fa-location-dot"></i>
                                <span>42 Green Garden Road,<br>
                                    Ahmedabad, Gujarat</span>
                            </p>
                            <p class="footer-contact">
                                <i class="fa-solid fa-phone"></i>
                                <span>+91 98765 43210</span>
                            </p>
                            <p class="footer-contact">
                                <i class="fa-solid fa-envelope"></i>
                                <span>info@greenleafnursery.com</span>
                            </p>
                            <p class="footer-contact">
                                <i class="fa-solid fa-clock"></i>
                                <span>Mon - Sat: 8:00 AM - 6:00 PM</span>
                            </p>
                        </div>
                    </div>

                    <hr class="footer-line">

                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <p class="copyright">&copy; 2026 <strong>GreenLeaf Nursery</strong>. All Rights Reserved.</p>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <p class="copyright">Made with <i class="fa-solid fa-heart" style="color: #BF5B32;"></i>for plant lovers.</p>
                        </div>
                    </div>
                </div>
            </footer>
        </asp:ContentPlaceHolder>
    </form>

    <!-- Bootstrap JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Custom JavaScript -->
    <script src="JS/script.js"></script>
</body>
</html>
